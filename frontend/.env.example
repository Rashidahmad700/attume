# Where the browser sends API calls. Relative on purpose: next.config rewrites
# /api/v1/* to API_ORIGIN, which keeps the session cookie first-party.
NEXT_PUBLIC_API_URL=/api/v1

# Where the server (and the rewrite) reaches the API. Not exposed to the browser.
API_ORIGIN=http://localhost:5000

# Public brand links
NEXT_PUBLIC_INSTAGRAM_HANDLE=attume.official
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/attume.official
