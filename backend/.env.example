# Copy to .env and fill in real values.

NODE_ENV=development
PORT=5000

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/attume

# ---- CORS ----
# Comma separated list of allowed browser origins (storefront, then admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Storefront JWT ----
# Generate each one separately: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Admin JWT (MUST differ from the storefront secrets) ----
ADMIN_JWT_ACCESS_SECRET=replace_me_admin_access_secret
ADMIN_JWT_REFRESH_SECRET=replace_me_admin_refresh_secret
ADMIN_JWT_ACCESS_EXPIRES_IN=30m
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# ---- Storefront proxy ----
# Same value as API_PROXY_SECRET on the storefront. Lets rate limits count each
# shopper instead of the storefront server. Generate: openssl rand -hex 32
API_PROXY_SECRET=

# ---- Cookies ----
# Production behind HTTPS on another domain: COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---- Instagram feed (optional) ----
# Without a token the API serves curated posts, so the section still renders.
# Token: Meta app > Instagram > API with Instagram Login > long-lived token.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PROFILE=attume.official

# ---- Commerce ----
COD_ENABLED=true
COD_MIN_ORDER_VALUE=0

# ---- Email (optional) ----
# Without a key the API prints sign-in and reset links to the terminal.
RESEND_API_KEY=
MAIL_FROM=attume <no-reply@houseofattume.com>
STOREFRONT_URL=http://localhost:3000

# 'prebook' takes interest without payment; 'live' opens the bag and checkout.
COMMERCE_MODE=prebook

# Notifications. Without keys, messages print to the server log instead of sending.
# Resend: https://resend.com — free tier covers a launch list.
RESEND_API_KEY=
MAIL_FROM=attume <no-reply@houseofattume.com>
ADMIN_NOTIFY_EMAIL=attume.official@gmail.com

# WhatsApp Cloud API (Meta). The customer confirmation needs an approved template.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_PREBOOK_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
ADMIN_WHATSAPP_NUMBER=

# Optional. Where images in email load from; defaults to STOREFRONT_URL.
# Only needed in development, where an inbox cannot reach localhost.
EMAIL_ASSET_BASE_URL=

# ---- Razorpay ----
# All three must be present before online payment is offered; without them the
# shop runs on cash on delivery alone. COMMERCE_MODE must also be "live".
#
# Keys:    Razorpay Dashboard > Settings > API Keys (test and live are separate)
# Webhook: Razorpay Dashboard > Settings > Webhooks
#          URL    https://<api-host>/api/v1/webhooks/razorpay
#          Events payment.captured, payment.failed, order.paid, refund.processed
#          Secret you choose it — openssl rand -hex 32 — and paste the same
#                 value into the dashboard and here. It must NOT equal the key
#                 secret: the webhook is a public endpoint and its signature is
#                 the only thing protecting it.
#
# A test key (rzp_test_...) with NODE_ENV=production refuses to start.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
