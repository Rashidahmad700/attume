# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/attume

# ---- CORS ----
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- JWT ----
# Use long random strings. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_access_secret
JWT_REFRESH_SECRET=replace_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Admin JWT (MUST be different values to the storefront secrets) ----
# A storefront token signed with the keys above can never authenticate against
# an admin route, because admin routes verify with these keys instead.
ADMIN_JWT_ACCESS_SECRET=replace_me_admin_access_secret
ADMIN_JWT_REFRESH_SECRET=replace_me_admin_refresh_secret
ADMIN_JWT_ACCESS_EXPIRES_IN=30m
ADMIN_JWT_REFRESH_EXPIRES_IN=7d

# ---- Cookies ----
# In production behind HTTPS on a different domain: COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
